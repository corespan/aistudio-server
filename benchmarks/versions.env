# =============================================================================
# Pinned container versions for reproducible benchmarks
# =============================================================================
#
# Every script in benchmarks/ sources this file instead of hardcoding a tag.
# It exists so that a benchmark run can be reproduced later, and so that the
# licence inventory of what actually ran is knowable.
#
# WHY NOT :latest
#   A published throughput number is only meaningful alongside the vLLM version
#   that produced it. `:latest` moves; the number does not. Two runs a month
#   apart against `:latest` are not comparable, and neither can be re-run.
#   It is also a licence problem: the transitive package set inside the image
#   changes with it, so the SBOM taken at release time stops describing what
#   users actually pull.
#
# HOW TO UPDATE
#   1. Pick the new tag.
#   2. Resolve its digest — this is what makes the pin immutable:
#        docker pull vllm/vllm-openai:<tag>
#        docker inspect --format='{{index .RepoDigests 0}}' vllm/vllm-openai:<tag>
#   3. Update both the tag and the digest below.
#   4. Re-run `make sbom` so the licence inventory matches.
#   5. Re-run the affected benchmarks. Do not carry old numbers forward across
#      a version bump — record them against the version that produced them.
#
# Override for a one-off experiment without editing this file:
#   VLLM_NVIDIA_TAG=v0.7.0 ./benchmarks/t4/tinyllama-tp1.sh
#
# =============================================================================

# ── NVIDIA (CUDA) ────────────────────────────────────────────────────────────
VLLM_NVIDIA_IMAGE="${VLLM_NVIDIA_IMAGE:-vllm/vllm-openai}"
VLLM_NVIDIA_TAG="${VLLM_NVIDIA_TAG:-v0.6.6.post1}"
# TODO(release): resolve and pin. Until set, runs use the mutable tag above.
VLLM_NVIDIA_DIGEST="${VLLM_NVIDIA_DIGEST:-}"

# ── AMD (ROCm) ───────────────────────────────────────────────────────────────
VLLM_ROCM_IMAGE="${VLLM_ROCM_IMAGE:-rocm/vllm}"
VLLM_ROCM_TAG="${VLLM_ROCM_TAG:-rocm6.3.1_mi300_ubuntu22.04_py3.12_vllm_0.6.6}"
# TODO(release): resolve and pin.
VLLM_ROCM_DIGEST="${VLLM_ROCM_DIGEST:-}"

# ── Resolution ───────────────────────────────────────────────────────────────
# Prefer the digest when present; fall back to the tag with a visible warning so
# nobody publishes a number from an unpinned run without noticing.

if [ -n "$VLLM_NVIDIA_DIGEST" ]; then
  CONTAINER_NVIDIA="${VLLM_NVIDIA_IMAGE}@${VLLM_NVIDIA_DIGEST}"
else
  CONTAINER_NVIDIA="${VLLM_NVIDIA_IMAGE}:${VLLM_NVIDIA_TAG}"
fi

if [ -n "$VLLM_ROCM_DIGEST" ]; then
  CONTAINER_ROCM="${VLLM_ROCM_IMAGE}@${VLLM_ROCM_DIGEST}"
else
  CONTAINER_ROCM="${VLLM_ROCM_IMAGE}:${VLLM_ROCM_TAG}"
fi

# Emitted into benchmark output so the run record carries its own provenance.
bench_provenance() {
  echo "── run provenance ────────────────────────────────────────────────"
  echo "  container : ${1:-unknown}"
  echo "  host      : $(hostname)"
  echo "  date      : $(date -u +%Y-%m-%dT%H:%M:%SZ)"
  echo "  repo      : $(git -C "$(dirname "${BASH_SOURCE[0]}")" rev-parse --short HEAD 2>/dev/null || echo 'not a git checkout')"
  case "${1:-}" in
    *@sha256:*) ;;
    *) echo "  WARNING   : image pinned by mutable tag, not digest — this run is not reproducible" ;;
  esac
  echo "──────────────────────────────────────────────────────────────────"
}
