# ── AIStudio Server — Environment Configuration ─────────────────────────────
# Copy this file: cp .env.example .env
# docker-compose reads .env automatically.

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USERNAME=aistudio
POSTGRES_PASSWORD=aistudio
POSTGRES_DATABASE=aistudio

# RabbitMQ
RABBITMQ_URL=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=aistudio
RABBITMQ_PASSWORD=aistudio

# Workload Images (GCP Artifact Registry)
# Full image path: us-docker.pkg.dev/aimlworkbench/workbench-registry/services/workloads/llminference:1.0.0
GCP_REGISTRY_URL=us-docker.pkg.dev
GCP_PROJECT_ID=aimlworkbench
GCP_REPOSITORY=workbench-registry
GCP_IMAGE_PATH=services/workloads
WORKLOAD_IMAGE_TAG=2.3.0-nvidia
JUPYTER_IMAGE_TAG=2.2.0-nvidia

# Model Storage — how your GPU node accesses model weights
#   "huggingface" = uses ~/.cache/huggingface (default, simplest)
#   "local"       = mounts MODEL_LOCAL_PATH into container
#   "gcs"         = sets GCS_BUCKET env in container
MODEL_STORAGE_MODE=huggingface
MODEL_LOCAL_PATH=/home/ubuntu/models
# MODEL_GCS_BUCKET=gs://your-bucket

# SSH — how Celery connects to your GPU node
SSH_KEY_PATH=~/.ssh/id_rsa
SSH_DEFAULT_USER=ubuntu

# Nginx reverse proxy (hides GPU node IPs, exposes public domain URLs)
# When enabled, Jupyter URLs become: {PROXY_BASE_URL}/jupyter/{GPU_TYPE}/{task_id}/lab
# nginx runs as a Docker service — no manual setup required.
NGINX_ENABLED=false
PROXY_BASE_URL=https://your-domain.com:8443
NGINX_CONF_DIR=/etc/nginx/jupyter-locations
# inotifywait inside the nginx container auto-reloads on file changes — no reload command needed.
NGINX_RELOAD_CMD=true
