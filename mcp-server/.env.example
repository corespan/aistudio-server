# MCP tool server settings, for running it outside compose: copy to .env. Values shown are the
# defaults. Under compose, docker-compose.yml sets these (profile "mcp"); see docs/mcp-server.md.

# ── aistudio-server ───────────────────────────────────────────────────────────
AISTUDIO_API_URL=http://localhost:8002

# ── Caller authentication ─────────────────────────────────────────────────────
# Set ONE of MCP_JWKS_FILE or MCP_JWKS_URL. gateway/mint.py init writes gateway/jwks.json.
MCP_JWKS_FILE=
MCP_JWKS_URL=
MCP_JWT_ISSUER=aistudio
MCP_JWT_AUDIENCE=mcp:aistudio
MCP_JWT_LEEWAY_SECONDS=30

# ── Write tools ───────────────────────────────────────────────────────────────
# start_workload, start_jupyter and stop_workload exist only when true (not even listed when false).
MCP_WRITES_ENABLED=false
# A repeated identical write within this window returns the first result. 0 = off.
MCP_WRITE_DEDUP_SECONDS=600

# ── SSH for GPU-node diagnostics ──────────────────────────────────────────────
SSH_KEY_PATH=/root/.ssh/id_rsa
SSH_DEFAULT_USER=ubuntu
SSH_CONNECT_TIMEOUT=10
# Login user for GPU nodes; blank = SSH_DEFAULT_USER.
NODE_SSH_USER=
# Host key policy: tofu or strict, using SSH_KNOWN_HOSTS.
SSH_KNOWN_HOSTS=~/.ssh/aistudio_mcp_known_hosts
SSH_HOST_KEY_POLICY=tofu
# Comma-separated CIDRs a node probe may reach, e.g. 192.0.2.0/24. Empty = node probes are off
# (they connect with the mounted SSH key, so nothing is reachable that is not listed).
NODE_ALLOWED_CIDRS=

# ── Docker daemon ─────────────────────────────────────────────────────────────
# Compose sets the read-only socket proxy (tcp://aistudio-docker-proxy:2375).
DOCKER_HOST=unix:///var/run/docker.sock

# ── Codebase / filesystem inspection ──────────────────────────────────────────
REPO_PATH=/repo
# read_file / list_dir allowlist, comma separated.
READABLE_ROOTS=/repo,/var/log
# Allowlist for paths read inside a container by container_diff.
CONTAINER_READABLE_ROOTS=/app,/srv,/usr/share/nginx/html,/repo,/AIStudio

# ── Network diagnostics ───────────────────────────────────────────────────────
NET_PROBE_TIMEOUT=5

# ── Frontend diagnostics ──────────────────────────────────────────────────────
# CDP endpoint of a headless browser; empty disables frontend_check. For example:
#   docker run -d -p 3001:3000 -e TOKEN=local browserless/chrome:latest
#   BROWSER_CDP_URL=ws://localhost:3001?token=local
BROWSER_CDP_URL=

# ── RabbitMQ management API (queue_status: queue depth + consumer count) ──────
# Credentials for queue_status; leave blank to disable.
RABBITMQ_MGMT_URL=http://localhost:15672
RABBITMQ_USER=
RABBITMQ_PASSWORD=

# -- HTTP transport -----------------------------------------------------------
# Bind address: 127.0.0.1 locally, 0.0.0.0 in Docker (publish no port).
MCP_HOST=127.0.0.1
MCP_PORT=8081
# Set both to serve https directly; leave blank when TLS terminates in front.
MCP_TLS_CERTFILE=
MCP_TLS_KEYFILE=
# Host header allow-list, comma separated, e.g. aistudio-mcp,aistudio-mcp:8081
MCP_ALLOWED_HOSTS=
