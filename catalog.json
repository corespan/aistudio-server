{
  "version": "1.1.0",
  "workload_types": [
    {
      "name": "LLMInference",
      "display_name": "LLM Inference (vLLM)",
      "description": "Benchmark LLM inference throughput and latency using vLLM. Measures tokens/sec, TTFT, TPOT, and end-to-end latency across configurable concurrency levels.",
      "image_tag": "1.0.0-nvidia"
    },
    {
      "name": "JupyterNotebook",
      "display_name": "Jupyter Notebook",
      "description": "Interactive Jupyter environment for running microbenchmarks and GPU profiling on remote nodes.",
      "image_tag": "1.0.0-nvidia"
    }
  ],
  "supported_models": [
