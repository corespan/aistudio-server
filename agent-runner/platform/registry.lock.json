  "connector": {
    "aistudio": {
      "source": "packs/aistudio/connectors/aistudio.yaml",
      "spec": {
        "audience": "aistudio-mcp",
        "browser": true,
        "description": "Benchmarks, workloads, logs, this host and the GPU nodes (mcp-server, docs/mcp-server.md).",
        "kind": "connector",
        "name": "aistudio",
        "rules": [
          "jwt.roles.aistudio in ['viewer', 'operator', 'admin'] && mcp.tool.name in ['workload_history', 'throughput_compare', 'check_service_health', 'platform_catalog', 'list_benchmarks', 'get_benchmark', 'summary', 'model_config', 'get_task_status', 'get_task_logs']",
          "jwt.roles.aistudio in ['operator', 'admin'] && mcp.tool.name in ['start_workload', 'start_jupyter', 'stop_jupyter', 'delete_run_results']",
          "jwt.roles.aistudio in ['admin'] && mcp.tool.name in ['timeline', 'list_containers', 'docker_logs', 'inspect_container', 'container_diff', 'read_file', 'list_dir', 'grep_logs', 'git_log', 'git_show', 'network_check', 'list_listening_ports', 'tcpdump_capture', 'check_tls_cert', 'check_clock_skew', 'frontend_check', 'queue_status', 'check_ssh_connectivity', 'check_node_docker', 'node_docker_logs', 'node_exec']"
        ],
        "upstream": "http://aistudio-mcp:8081/mcp"
      }
    },
    "sandbox": {
      "source": "packs/core/connectors/sandbox.yaml",
      "spec": {
        "audience": null,
        "browser": false,
        "description": "Run a short program in a no-network gVisor container, and repo workspaces for the coding workflow (sandbox-mcp, docs/sandbox.md).",
        "kind": "connector",
        "name": "sandbox",
        "rules": [
          "jwt.roles.aistudio in ['viewer', 'operator', 'admin'] && mcp.tool.name in ['sandbox_run']",
          "jwt.roles.aistudio in ['operator', 'admin'] && mcp.tool.name in ['workspace_open', 'workspace_claude', 'workspace_exec', 'workspace_diff', 'workspace_files', 'workspace_close']"
        ],
        "upstream": "http://sandbox-mcp:8082/mcp"
      }
    }
  },
